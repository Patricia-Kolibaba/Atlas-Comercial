-- ============================================================
-- Vendaflow CRM — Schema v2 (arquitetura completa)
-- Rode este arquivo inteiro no Supabase: SQL Editor > New query > Run
-- Este schema é aditivo: ele NÃO mexe na tabela crm_data já existente,
-- então nada do que já funciona hoje quebra.
-- ============================================================

-- extensão para gerar UUIDs
create extension if not exists "pgcrypto";

-- ------------------------------------------------------------
-- 1. USERS (perfil de cada login — Administrador ou Vendedor)
-- ------------------------------------------------------------
create table if not exists public.users (
  id uuid primary key references auth.users(id) on delete cascade,
  nome text not null default 'Usuário',
  email text,
  role text not null default 'vendedor' check (role in ('admin', 'vendedor')),
  ativo boolean not null default true,
  created_at timestamptz not null default now()
);

-- cria automaticamente um perfil "vendedor" quando alguém se cadastra no Supabase Auth
create or replace function public.handle_new_user()
returns trigger as $$
begin
  insert into public.users (id, nome, email, role)
  values (new.id, coalesce(new.raw_user_meta_data->>'nome', split_part(new.email, '@', 1)), new.email, 'vendedor')
  on conflict (id) do nothing;
  return new;
end;
$$ language plpgsql security definer;

drop trigger if exists on_auth_user_created on auth.users;
create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

-- função auxiliar: o usuário logado é admin?
create or replace function public.is_admin()
returns boolean as $$
  select exists (select 1 from public.users where id = auth.uid() and role = 'admin');
$$ language sql security definer stable;

-- ------------------------------------------------------------
-- 2. FUNNELS e FUNNEL_STAGES (funis de negociação e etapas)
-- ------------------------------------------------------------
create table if not exists public.funnels (
  id uuid primary key default gen_random_uuid(),
  nome text not null,
  created_at timestamptz not null default now()
);

create table if not exists public.funnel_stages (
  id uuid primary key default gen_random_uuid(),
  funnel_id uuid not null references public.funnels(id) on delete cascade,
  nome text not null,
  ordem int not null default 0,
  is_won boolean not null default false,
  is_lost boolean not null default false,
  created_at timestamptz not null default now()
);
create index if not exists idx_funnel_stages_funnel on public.funnel_stages(funnel_id);

-- ------------------------------------------------------------
-- 3. CLIENTS e CONTACTS (revendas/clientes e pessoas de contato)
-- ------------------------------------------------------------
create table if not exists public.clients (
  id uuid primary key default gen_random_uuid(),
  nome text not null,
  empresa text,
  estado text,
  telefone text,
  email text,
  owner_id uuid references public.users(id),
  created_at timestamptz not null default now()
);
create index if not exists idx_clients_owner on public.clients(owner_id);

create table if not exists public.contacts (
  id uuid primary key default gen_random_uuid(),
  client_id uuid not null references public.clients(id) on delete cascade,
  nome text not null,
  cargo text,
  telefone text,
  email text,
  created_at timestamptz not null default now()
);
create index if not exists idx_contacts_client on public.contacts(client_id);

-- ------------------------------------------------------------
-- 4. PRODUCTS
-- ------------------------------------------------------------
create table if not exists public.products (
  id uuid primary key default gen_random_uuid(),
  nome text not null,
  preco numeric(12,2) default 0,
  descricao text,
  ativo boolean not null default true,
  created_at timestamptz not null default now()
);

-- ------------------------------------------------------------
-- 5. NEGOTIATIONS (negociações / projetos)
-- ------------------------------------------------------------
create table if not exists public.negotiations (
  id uuid primary key default gen_random_uuid(),
  titulo text not null,
  client_id uuid references public.clients(id),
  contact_id uuid references public.contacts(id),
  owner_id uuid references public.users(id),
  funnel_id uuid references public.funnels(id),
  stage_id uuid references public.funnel_stages(id),
  valor numeric(12,2) default 0,
  previsao_fechamento date,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index if not exists idx_negotiations_owner on public.negotiations(owner_id);
create index if not exists idx_negotiations_client on public.negotiations(client_id);
create index if not exists idx_negotiations_stage on public.negotiations(stage_id);

-- ------------------------------------------------------------
-- 6. ACTIVITY_TYPES e ACTIVITIES
-- ------------------------------------------------------------
create table if not exists public.activity_types (
  id uuid primary key default gen_random_uuid(),
  nome text not null
);

create table if not exists public.activities (
  id uuid primary key default gen_random_uuid(),
  negotiation_id uuid references public.negotiations(id) on delete cascade,
  client_id uuid references public.clients(id),
  owner_id uuid references public.users(id),
  activity_type_id uuid references public.activity_types(id),
  descricao text,
  data date not null,
  hora time not null,
  concluida boolean not null default false,
  created_at timestamptz not null default now()
);
create index if not exists idx_activities_owner on public.activities(owner_id);
create index if not exists idx_activities_negotiation on public.activities(negotiation_id);
create index if not exists idx_activities_data on public.activities(data);

-- ------------------------------------------------------------
-- 7. REMINDERS, NOTES, REPORTS
-- ------------------------------------------------------------
create table if not exists public.reminders (
  id uuid primary key default gen_random_uuid(),
  owner_id uuid references public.users(id),
  negotiation_id uuid references public.negotiations(id) on delete cascade,
  titulo text not null,
  data date,
  hora time,
  created_at timestamptz not null default now()
);
create index if not exists idx_reminders_owner on public.reminders(owner_id);

create table if not exists public.notes (
  id uuid primary key default gen_random_uuid(),
  owner_id uuid references public.users(id),
  client_id uuid references public.clients(id) on delete cascade,
  negotiation_id uuid references public.negotiations(id) on delete cascade,
  conteudo text not null,
  created_at timestamptz not null default now()
);
create index if not exists idx_notes_owner on public.notes(owner_id);
create index if not exists idx_notes_client on public.notes(client_id);

create table if not exists public.reports (
  id uuid primary key default gen_random_uuid(),
  nome text not null,
  tipo text,
  config jsonb not null default '{}'::jsonb,
  owner_id uuid references public.users(id),
  created_at timestamptz not null default now()
);

-- ============================================================
-- ROW LEVEL SECURITY
-- ============================================================
alter table public.users enable row level security;
alter table public.clients enable row level security;
alter table public.contacts enable row level security;
alter table public.negotiations enable row level security;
alter table public.activities enable row level security;
alter table public.products enable row level security;
alter table public.funnels enable row level security;
alter table public.funnel_stages enable row level security;
alter table public.activity_types enable row level security;
alter table public.reminders enable row level security;
alter table public.notes enable row level security;
alter table public.reports enable row level security;

-- USERS: cada um vê o próprio perfil; admin vê e edita todos
create policy "users_select" on public.users for select using (id = auth.uid() or public.is_admin());
create policy "users_update_self" on public.users for update using (id = auth.uid() or public.is_admin());
create policy "users_insert_admin" on public.users for insert with check (public.is_admin());

-- CLIENTS: admin vê tudo; vendedor vê só os seus
create policy "clients_select" on public.clients for select using (public.is_admin() or owner_id = auth.uid());
create policy "clients_insert" on public.clients for insert with check (public.is_admin() or owner_id = auth.uid());
create policy "clients_update" on public.clients for update using (public.is_admin() or owner_id = auth.uid());
create policy "clients_delete" on public.clients for delete using (public.is_admin());

-- CONTACTS: segue a permissão do cliente relacionado
create policy "contacts_select" on public.contacts for select using (
  public.is_admin() or exists (select 1 from public.clients c where c.id = contacts.client_id and c.owner_id = auth.uid())
);
create policy "contacts_write" on public.contacts for all using (
  public.is_admin() or exists (select 1 from public.clients c where c.id = contacts.client_id and c.owner_id = auth.uid())
);

-- NEGOTIATIONS: admin vê tudo; vendedor vê só as suas
create policy "negotiations_select" on public.negotiations for select using (public.is_admin() or owner_id = auth.uid());
create policy "negotiations_insert" on public.negotiations for insert with check (public.is_admin() or owner_id = auth.uid());
create policy "negotiations_update" on public.negotiations for update using (public.is_admin() or owner_id = auth.uid());
create policy "negotiations_delete" on public.negotiations for delete using (public.is_admin());

-- ACTIVITIES: admin vê tudo; vendedor vê só as suas
create policy "activities_select" on public.activities for select using (public.is_admin() or owner_id = auth.uid());
create policy "activities_insert" on public.activities for insert with check (public.is_admin() or owner_id = auth.uid());
create policy "activities_update" on public.activities for update using (public.is_admin() or owner_id = auth.uid());
create policy "activities_delete" on public.activities for delete using (public.is_admin() or owner_id = auth.uid());

-- PRODUCTS, FUNNELS, FUNNEL_STAGES, ACTIVITY_TYPES: todo mundo logado lê; só admin edita
create policy "products_select" on public.products for select using (auth.role() = 'authenticated');
create policy "products_write" on public.products for insert with check (public.is_admin());
create policy "products_update" on public.products for update using (public.is_admin());
create policy "products_delete" on public.products for delete using (public.is_admin());

create policy "funnels_select" on public.funnels for select using (auth.role() = 'authenticated');
create policy "funnels_write" on public.funnels for insert with check (public.is_admin());
create policy "funnels_update" on public.funnels for update using (public.is_admin());
create policy "funnels_delete" on public.funnels for delete using (public.is_admin());

create policy "funnel_stages_select" on public.funnel_stages for select using (auth.role() = 'authenticated');
create policy "funnel_stages_write" on public.funnel_stages for insert with check (public.is_admin());
create policy "funnel_stages_update" on public.funnel_stages for update using (public.is_admin());
create policy "funnel_stages_delete" on public.funnel_stages for delete using (public.is_admin());

create policy "activity_types_select" on public.activity_types for select using (auth.role() = 'authenticated');
create policy "activity_types_write" on public.activity_types for insert with check (public.is_admin());
create policy "activity_types_update" on public.activity_types for update using (public.is_admin());
create policy "activity_types_delete" on public.activity_types for delete using (public.is_admin());

-- REMINDERS, NOTES: admin vê tudo; vendedor vê só os seus
create policy "reminders_all" on public.reminders for all using (public.is_admin() or owner_id = auth.uid());
create policy "notes_all" on public.notes for all using (public.is_admin() or owner_id = auth.uid());

-- REPORTS: admin vê tudo; vendedor vê só os seus
create policy "reports_all" on public.reports for all using (public.is_admin() or owner_id = auth.uid());

-- ============================================================
-- Dados iniciais (funil padrão)
-- ============================================================
insert into public.funnels (nome) select 'Funil Padrão' where not exists (select 1 from public.funnels);

insert into public.funnel_stages (funnel_id, nome, ordem, is_won, is_lost)
select f.id, s.nome, s.ordem, s.is_won, s.is_lost
from public.funnels f,
  (values
    ('Oportunidade', 1, false, false),
    ('Em Andamento', 2, false, false),
    ('Previsão de Fechamento', 3, false, false),
    ('Negócio Ganho', 4, true, false),
    ('Negócio Perdido', 5, false, true)
  ) as s(nome, ordem, is_won, is_lost)
where f.nome = 'Funil Padrão'
  and not exists (select 1 from public.funnel_stages fs where fs.funnel_id = f.id);

